# ============================================================================
# cline-register 配置
# 复制为 cline-register/.env 后按需修改。所有键都是可选的，缺省走默认值。
# 也可以直接在仓库根 .env 里写，注册机会按
#   cline-register/.env  ->  仓库根 .env  ->  cline2api/cline2api/.env
# 的顺序补齐（后面的只补前面没设的键）。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、账号库存（必填，否则注册机没有可处理的账号）
# ---------------------------------------------------------------------------
# 待登录的目标账号，每行：邮箱----密码
# 默认读 cline-register/config/mail/all_web_mail.txt
# 可用 REGISTER_WEB_MAIL 指定其他文件名（放在 config/mail/ 下）
# REGISTER_WEB_MAIL=all_web_mail.txt

# 辅助接码邮箱库存（自带 Microsoft Graph API refresh token），
# 每行：邮箱----密码----clientId----refreshToken----辅助邮箱----辅助邮箱密码
# 默认读 cline-register/config/mail/new_mail.txt
# REGISTER_HELPER_MAIL=new_mail.txt

# ---------------------------------------------------------------------------
# 二、Cline / WorkOS 上游（一般不用改）
# ---------------------------------------------------------------------------
CLINE_API_BASE_URL=https://api.cline.bot
WORKOS_API_BASE_URL=https://api.workos.com
WORKOS_CLIENT_ID=client_01K3A541FN8TA3EPPHTD2325AR

# ---------------------------------------------------------------------------
# 三、浏览器
# ---------------------------------------------------------------------------
# Chrome 可执行文件路径（Windows 默认值见下，Linux/macOS 请自行改）
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 设成 false 可以看着浏览器跑，方便排查问题
REGISTER_HEADLESS=true

# 并发数（同时处理几个账号）。每个并发 = 一个 Chrome + 一个回调端口。
# 默认 1；建议 2-3；上限 8。等价于命令行 --concurrency N
# REGISTER_CONCURRENCY=1
# 并发硬上限（默认 64）。内存充足可以往上调，例如 128
# REGISTER_MAX_CONCURRENCY=64
# 浏览器复用：true=一个 Chrome 开多个隔离标签（默认，省内存）
#              false=每个账号独立起一个 Chrome（更费内存）
# REGISTER_SHARED_BROWSER=true

# ---------------------------------------------------------------------------
# 四、远程 cline2api 网关（要把凭据推到远端时必填）
# ---------------------------------------------------------------------------
# 远程网关地址，例如 https://cline.example.com
CLINE2API_REMOTE_URL=
# 远程网关的 ADMIN_TOKEN（在网关的 .env 里设置的那个）
CLINE2API_ADMIN_TOKEN=
# 导入接口路径，一般不用改
# CLINE2API_IMPORT_PATH=/admin/api/accounts/import
# 推送请求超时（毫秒）
# CLINE2API_PUSH_TIMEOUT_MS=30000
# 推送/探测走的 HTTP 代理（留空则直连）
# CLINE2API_PROXY=http://127.0.0.1:7897

# ---------------------------------------------------------------------------
# 五、本地落盘（一般不用改）
# ---------------------------------------------------------------------------
# 每注册成功一个账号，顺手把最新凭据写一份到这里，方便本地网关直接读
TOKEN_CACHE_PATH=.cache/tokens.json



