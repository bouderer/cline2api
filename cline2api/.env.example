# ---------------------------------------------------------------------------
# cline2api configuration. Copy to .env and edit. Never commit a filled .env.
# ---------------------------------------------------------------------------

# --- client-facing API keys ------------------------------------------------
# Comma-separate to accept several keys. On boot each value is imported into
# the on-disk key store (data/apikeys.json) and authentication reads from the
# store afterwards — manage keys from the admin UI instead of editing this.
#
# Removing a key here removes it from the store on the next boot, so deleting
# from only one side leaves the gateway in a confusing state: use the UI.
# Keys tagged "env #N" in the UI come from this line and cannot be deleted
# there; unset them here instead.
PROXY_API_KEY=

# --- admin UI --------------------------------------------------------------
# REQUIRED whenever the admin UI or /admin APIs can be reached through a proxy or
# public network. When unset, admin routes are only allowed from loopback.
ADMIN_TOKEN=

# --- listener --------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# --- docker compose only ---------------------------------------------------
# Host path mounted at /data by docker-compose.yml. Leave unset for ./data,
# which is correct when this directory is the repo root. Set it when the live
# accounts live elsewhere — for example a checkout whose data/ predates the
# move into cline2api/. Getting it wrong mounts an empty directory and the
# gateway starts with zero accounts, with no error to point at it.
# DATA_DIR_HOST=/path/to/accounts

# --- upstream (defaults come from the official Cline production config) -----
CLINE_API_BASE_URL=https://api.cline.bot
WORKOS_API_BASE_URL=https://api.workos.com
WORKOS_CLIENT_ID=client_01K3A541FN8TA3EPPHTD2325AR

# --- token lifetime policy -------------------------------------------------
# Refresh this long before expiry (default 5 min).
REFRESH_BUFFER_MS=300000
# On a transient refresh failure, keep using a still-valid token this long.
RETRYABLE_TOKEN_GRACE_MS=30000
REQUEST_TIMEOUT_MS=30000
MODEL_CACHE_TTL_MS=300000

# --- rate limiting ---------------------------------------------------------
# Defaults only. The live values live in data/ratelimit.json and are edited
# from the admin UI (keys page), so changing these here has no effect once that
# file exists. Applies to the model-call routes only: /v1/chat/completions,
# /v1/responses and /v1/messages.
#
# A key over its ceiling is refused immediately with 429 + Retry-After, so a
# client holding several keys can switch to another one. The gateway-wide
# ceiling waits briefly for a slot before refusing, since there is no other key
# to switch to.
RATE_LIMIT_GLOBAL_PER_MINUTE=400
RATE_LIMIT_KEY_PER_MINUTE=200

# --- headers presented upstream (mirrors the official SDK) ------------------
CLINE_CLIENT_NAME=cline-sdk
CLINE_CLIENT_VERSION=3.0.62
CLINE_PLATFORM=unknown
CLINE_PLATFORM_VERSION=unknown
CLINE_CORE_VERSION=0.0.83
